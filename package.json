{
  "name": "@ryamgoh/terminal-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.ryamgoh/terminal-mcp",
  "description": "MCP server that lets agents create and control real terminal sessions: run commands, read output by cursor, type into interactive programs, see state, kill process trees",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "terminal",
    "pty",
    "shell",
    "agent",
    "ai",
    "node-pty",
    "xterm"
  ],
  "author": "Ryann Goh",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "terminal-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "shell-integration",
    "THIRD_PARTY_NOTICES.md",
    "MACOS.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run build && vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "smoke": "npm run build && tsx test/smoke.ts",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/cli.js",
    "prepack": "npm run build",
    "version": "node scripts/sync-server-json.mjs && git add server.json",
    "demo": "npm run build && tsx examples/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^15.1.0",
    "express": "^5.3.0",
    "node-pty": "^1.1.0",
    "pino": "^10.4.0",
    "tree-kill": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryamgoh/terminal-mcp.git"
  },
  "homepage": "https://github.com/ryamgoh/terminal-mcp#readme",
  "bugs": {
    "url": "https://github.com/ryamgoh/terminal-mcp/issues"
  }
}
